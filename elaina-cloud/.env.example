# Public browser config (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
CLOUDFLARE_ZONE_ID=YOUR_CLOUDFLARE_ZONE_ID
DOMAIN_SUFFIX=elaina-cloud.my.id

# Optional: comma-separated admin email(s), used only during initial setup
INITIAL_ADMIN_EMAILS=you@example.com

# Comma-separated exact hostnames allowed as API proxy destinations (required)
API_PROXY_ALLOWED_HOSTS=api.example.com,api2.example.com
